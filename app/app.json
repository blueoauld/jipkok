{
  "expo": {
    "name": "집콕",
    "slug": "jipkok",
    "platforms": ["ios", "android"],
    "version": "1.0.5",
    "updates": {
      "url": "https://u.expo.dev/137fcaaf-79ed-43b4-aec3-1b2472f02adc"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "jipkok",
    "locales": {
      "ja": "./locales/ja.json",
      "en": "./locales/en.json",
      "zh-Hant": "./locales/zh-Hant.json"
    },
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.blueoauld.jipkok",
      "supportsTablet": true,
      "requireFullScreen": true,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "ko",
        "ITSAppUsesNonExemptEncryption": false
      },
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#007AFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "com.google.android.gms.permission.AD_ID"
      ],
      "package": "com.blueoauld.jipkok",
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#141414",
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 160
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "프로필, 피드, 신고에 사진을 올리고 대화에서 사진과 동영상을 보내기 위해 사진 접근 권한이 필요합니다.",
          "cameraPermission": "사진을 찍어 올리거나 보내기 위해 카메라 접근 권한이 필요합니다.",
          "microphonePermission": "동영상을 찍어 보내기 위해 마이크 접근 권한이 필요합니다."
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-5005991782528987~6477732253",
          "iosAppId": "ca-app-pub-5005991782528987~9659285597"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "가까운 회원을 거리순으로 보기 위해 위치 접근 권한이 필요합니다."
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "관심사에 맞는 광고를 보여주기 위해 활동 추적 권한이 필요합니다."
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/analytics",
      "@react-native-firebase/crashlytics",
      "@react-native-firebase/perf",
      "./plugins/withFirebaseDisableSPM",
      "./plugins/withAndroidAdsKotlinFix",
      "./plugins/withAndroidR8Optimization",
      [
        "expo-media-library",
        {
          "photosPermission": "프로필, 피드, 신고에 사진을 올리고 대화에서 사진과 동영상을 보내기 위해 사진 접근 권한이 필요합니다.",
          "savePhotosPermission": "대화에서 받은 사진과 동영상을 저장하기 위해 사진 접근 권한이 필요합니다.",
          "granularPermissions": ["photo"]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-image",
      "expo-video",
      "expo-localization",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "앱 잠금을 풀기 위해 Face ID 사용 권한이 필요합니다."
        }
      ],
      "expo-sharing",
      "react-native-zip-archive"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "137fcaaf-79ed-43b4-aec3-1b2472f02adc"
      }
    },
    "owner": "jipkok"
  }
}
