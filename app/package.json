{
  "name": "app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@bacons/text-decoder": "^0.0.0",
    "@react-native-firebase/analytics": "^26.2.0",
    "@react-native-firebase/app": "^26.2.0",
    "@react-native-firebase/crashlytics": "^26.2.0",
    "@react-native-firebase/perf": "^26.2.0",
    "@stomp/stompjs": "^7.3.0",
    "@tamagui/config": "^2.7.4",
    "@tanstack/react-query": "^5.101.4",
    "expo": "~57.0.14",
    "expo-build-properties": "~57.0.12",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.7",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-image-manipulator": "~57.0.11",
    "expo-image-picker": "~57.0.11",
    "expo-keep-awake": "~57.0.1",
    "expo-localization": "~57.0.1",
    "expo-location": "~57.0.11",
    "expo-media-library": "~57.0.4",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.12",
    "expo-router": "~57.0.14",
    "expo-screen-capture": "~57.0.2",
    "expo-secure-store": "^57.0.1",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.2",
    "expo-system-ui": "~57.0.1",
    "expo-tracking-transparency": "~57.0.1",
    "expo-updates": "~57.0.15",
    "expo-video": "~57.0.2",
    "expo-video-thumbnails": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "i18next": "^26.4.0",
    "phosphor-react-native": "^3.0.6",
    "react": "19.2.3",
    "react-hook-form": "^7.84.0",
    "react-i18next": "^17.0.12",
    "react-native": "0.86.2",
    "react-native-calendars": "^1.1314.0",
    "react-native-compressor": "^1.19.4",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-google-mobile-ads": "^16.4.0",
    "react-native-keyboard-controller": "^1.22.3",
    "react-native-mmkv": "^4.3.2",
    "react-native-reanimated": "4.5.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.11.4",
    "react-native-zoom-reanimated": "^1.5.4",
    "tamagui": "^2.7.4",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@emnapi/core": "1.10.0",
    "@emnapi/runtime": "1.10.0",
    "@tamagui/babel-plugin": "^2.6.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.4",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "api:types": "npx --yes openapi-typescript@7 openapi.json -o src/lib/api/schema.ts",
    "postinstall": "patch-package",
    "test": "jest"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^expo-modules-core$": "<rootDir>/node_modules/expo/node_modules/expo-modules-core",
      "^expo-modules-core/(.*)$": "<rootDir>/node_modules/expo/node_modules/expo-modules-core/$1",
      "^react-native-mmkv$": "<rootDir>/src/lib/__tests__/mmkv-mock.ts"
    },
    "setupFiles": [
      "<rootDir>/src/lib/__tests__/localization-mock.ts",
      "<rootDir>/src/lib/__tests__/crashlytics-mock.ts"
    ],
    "testMatch": [
      "<rootDir>/src/**/*.test.ts",
      "<rootDir>/src/**/*.test.tsx"
    ]
  },
  "overrides": {
    "expo-modules-core": {
      "react-native-worklets": "$react-native-worklets"
    }
  },
  "expo": {
    "autolinking": {
      "apple": {
        "exclude": [
          "@expo/ui"
        ]
      }
    }
  }
}
