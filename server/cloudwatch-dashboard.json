    {
      "type": "text",
      "x": 0,
      "y": 14,
      "width": 24,
      "height": 1,
      "properties": {
        "markdown": "## 요청"
      }
    },
    {
      "type": "log",
      "x": 0,
      "y": 15,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "분당 요청 수",
        "region": "ap-northeast-2",
        "view": "timeSeries",
        "query": "SOURCE '/jipkok/server' | fields @timestamp, message\n| parse message /^(?<method>[A-Z]+) (?<path>[^?\\s]+)\\S* (?<status>\\d{3}) (?<ms>\\d+)ms$/\n| filter ispresent(status)\n| stats count() as requests by bin(1m)"
      }
    },
    {
      "type": "log",
      "x": 12,
      "y": 15,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "상태 코드 분포",
        "region": "ap-northeast-2",
        "view": "table",
        "query": "SOURCE '/jipkok/server' | fields @timestamp, message\n| parse message /^(?<method>[A-Z]+) (?<path>[^?\\s]+)\\S* (?<status>\\d{3}) (?<ms>\\d+)ms$/\n| filter ispresent(status)\n| stats count() as cnt by status\n| sort cnt desc"
      }
    },
    {
      "type": "log",
      "x": 0,
      "y": 21,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "느린 요청 (1초 이상)",
        "region": "ap-northeast-2",
        "view": "table",
        "query": "SOURCE '/jipkok/server' | fields @timestamp, message, requestId, memberId\n| parse message /^(?<method>[A-Z]+) (?<path>[^?\\s]+)\\S* (?<status>\\d{3}) (?<ms>\\d+)ms$/\n| filter ispresent(ms) and ms > 1000\n| sort ms desc\n| limit 50"
      }
    },
    {
      "type": "log",
      "x": 12,
      "y": 21,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "느린 경로 평균",
        "region": "ap-northeast-2",
        "view": "table",
        "query": "SOURCE '/jipkok/server' | fields @timestamp, message\n| parse message /^(?<method>[A-Z]+) (?<path>[^?\\s]+)\\S* (?<status>\\d{3}) (?<ms>\\d+)ms$/\n| filter ispresent(ms)\n| stats avg(ms) as avgMs, max(ms) as maxMs, count() as cnt by method, path\n| sort avgMs desc\n| limit 20"
      }
    },
    {
      "type": "text",
      "x": 0,
      "y": 27,
      "width": 24,
      "height": 1,
      "properties": {
        "markdown": "## 오류"
      }
    },
    {
      "type": "log",
      "x": 0,
      "y": 28,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "분당 오류 수",
        "region": "ap-northeast-2",
        "view": "timeSeries",
        "query": "SOURCE '/jipkok/server' | fields @timestamp\n| filter log.level = \"ERROR\"\n| stats count() as errors by bin(1m)"
      }
    },
    {
      "type": "log",
      "x": 12,
      "y": 28,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "오류 종류",
        "region": "ap-northeast-2",
        "view": "table",
        "query": "SOURCE '/jipkok/server' | fields @timestamp, error.type\n| filter log.level = \"ERROR\"\n| stats count() as cnt by error.type\n| sort cnt desc\n| limit 20"
      }
    },
    {
      "type": "log",
      "x": 0,
      "y": 34,
      "width": 24,
      "height": 8,
      "properties": {
        "title": "최근 오류",
        "region": "ap-northeast-2",
        "view": "table",
        "query": "SOURCE '/jipkok/server' | fields @timestamp, log.logger as logger, message, requestId, memberId\n| filter log.level = \"ERROR\"\n| sort @timestamp desc\n| limit 50"
      }
    },
    {
      "type": "text",
      "x": 0,
      "y": 42,
      "width": 24,
      "height": 1,
      "properties": {
        "markdown": "## 프록시"
      }
    },
    {
      "type": "log",
      "x": 0,
      "y": 43,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Caddy 상태 코드",
        "region": "ap-northeast-2",
        "view": "timeSeries",
        "query": "SOURCE '/jipkok/caddy' | fields @timestamp, status\n| filter ispresent(status)\n| stats count() by status, bin(5m)"
      }
    },
    {
      "type": "log",
      "x": 12,
      "y": 43,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Caddy 오류 응답",
        "region": "ap-northeast-2",
        "view": "table",
        "query": "SOURCE '/jipkok/caddy' | fields @timestamp, status, request.uri as uri, request.method as method\n| filter status >= 400\n| sort @timestamp desc\n| limit 50"
      }
    }
  ]
