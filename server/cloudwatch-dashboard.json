    {
      "type": "text",
      "x": 0,
      "y": 20,
      "width": 24,
      "height": 1,
      "properties": {
        "markdown": "## 요청"
      }
    },
    {
      "type": "log",
      "x": 0,
      "y": 21,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "요청 수 (5분)",
        "region": "ap-northeast-2",
        "view": "timeSeries",
        "query": "SOURCE '/jipkok/server' | fields @timestamp, message\n| parse message /^(?<method>[A-Z]+) (?<path>[^?\\s]+)\\S* (?<status>\\d{3}) (?<ms>\\d+)ms$/\n| filter ispresent(status)\n| stats count() as requests by bin(5m)"
      }
    },
    {
      "type": "log",
      "x": 12,
      "y": 21,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "상태 코드 분포",
        "region": "ap-northeast-2",
        "view": "table",
        "query": "SOURCE '/jipkok/server' | fields @timestamp, message\n| parse message /^(?<method>[A-Z]+) (?<path>[^?\\s]+)\\S* (?<status>\\d{3}) (?<ms>\\d+)ms$/\n| filter ispresent(status)\n| stats count() as cnt by status\n| sort cnt desc"
      }
    },
    {
      "type": "log",
      "x": 0,
      "y": 27,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "5xx 추이 (5분)",
        "region": "ap-northeast-2",
        "view": "timeSeries",
        "query": "SOURCE '/jipkok/server' | fields @timestamp, message\n| parse message /^(?<method>[A-Z]+) (?<path>[^?\\s]+)\\S* (?<status>\\d{3}) (?<ms>\\d+)ms$/\n| filter status >= 500\n| stats count() as serverErrors by bin(5m)"
      }
    },
    {
      "type": "log",
      "x": 12,
      "y": 27,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "429 추이 (5분)",
        "region": "ap-northeast-2",
        "view": "timeSeries",
        "query": "SOURCE '/jipkok/server' | fields @timestamp, message\n| parse message /^(?<method>[A-Z]+) (?<path>[^?\\s]+)\\S* (?<status>\\d{3}) (?<ms>\\d+)ms$/\n| filter status = 429\n| stats count() as blocked by bin(5m)"
      }
    },
    {
      "type": "log",
      "x": 0,
      "y": 33,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "느린 요청 (1초 이상)",
        "region": "ap-northeast-2",
        "view": "table",
        "query": "SOURCE '/jipkok/server' | fields @timestamp, message, requestId, memberId, appVersion, platform\n| parse message /^(?<method>[A-Z]+) (?<path>[^?\\s]+)\\S* (?<status>\\d{3}) (?<ms>\\d+)ms$/\n| filter ispresent(ms) and ms > 1000\n| sort ms desc\n| limit 50"
      }
    },
    {
      "type": "log",
      "x": 12,
      "y": 33,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "느린 경로 (p95 기준)",
        "region": "ap-northeast-2",
        "view": "table",
        "query": "SOURCE '/jipkok/server' | fields @timestamp, message\n| parse message /^(?<method>[A-Z]+) (?<path>[^?\\s]+)\\S* (?<status>\\d{3}) (?<ms>\\d+)ms$/\n| filter ispresent(ms)\n| parse path /^(?<resource>\\/api\\/[a-z-]+(?:\\/me)?)(?:\\/\\d+)?(?<sub>\\/[a-z-]+)?/\n| stats count() as cnt, avg(ms) as avgMs, pct(ms, 95) as p95, pct(ms, 99) as p99, max(ms) as maxMs by method, resource, sub\n| sort p95 desc\n| limit 20"
      }
    },
    {
      "type": "text",
      "x": 0,
      "y": 39,
      "width": 24,
      "height": 1,
      "properties": {
        "markdown": "## 클라이언트"
      }
    },
    {
      "type": "log",
      "x": 0,
      "y": 40,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "버전별 요청",
        "region": "ap-northeast-2",
        "view": "table",
        "query": "SOURCE '/jipkok/server' | fields @timestamp, message, appVersion, platform\n| parse message /^(?<method>[A-Z]+) (?<path>[^?\\s]+)\\S* (?<status>\\d{3}) (?<ms>\\d+)ms$/\n| filter ispresent(status) and ispresent(appVersion)\n| stats count() as requests by platform, appVersion\n| sort requests desc\n| limit 30"
      }
    },
    {
      "type": "log",
      "x": 12,
      "y": 40,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "버전별 오류",
        "region": "ap-northeast-2",
        "view": "table",
        "query": "SOURCE '/jipkok/server' | fields @timestamp, appVersion, platform, error.type\n| filter log.level = \"ERROR\"\n| stats count() as errors by platform, appVersion, error.type\n| sort errors desc\n| limit 30"
      }
    },
    {
      "type": "text",
      "x": 0,
      "y": 46,
      "width": 24,
      "height": 1,
      "properties": {
        "markdown": "## 오류"
      }
    },
    {
      "type": "log",
      "x": 0,
      "y": 47,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "오류 수 (5분)",
        "region": "ap-northeast-2",
        "view": "timeSeries",
        "query": "SOURCE '/jipkok/server' | fields @timestamp\n| filter log.level = \"ERROR\"\n| stats count() as errors by bin(5m)"
      }
    },
    {
      "type": "log",
      "x": 12,
      "y": 47,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "오류 종류",
        "region": "ap-northeast-2",
        "view": "table",
        "query": "SOURCE '/jipkok/server' | fields @timestamp, error.type\n| filter log.level = \"ERROR\"\n| stats count() as cnt by error.type\n| sort cnt desc\n| limit 20"
      }
    },
    {
      "type": "log",
      "x": 0,
      "y": 53,
      "width": 24,
      "height": 4,
      "properties": {
        "title": "기동 횟수 (배포 외에 오르면 재시작)",
        "region": "ap-northeast-2",
        "view": "timeSeries",
        "query": "SOURCE '/jipkok/server' | fields @timestamp, message\n| filter message like /^Started .+ in .+ seconds/\n| stats count() as starts by bin(1h)"
      }
    },
    {
      "type": "log",
      "x": 0,
      "y": 57,
      "width": 24,
      "height": 8,
      "properties": {
        "title": "최근 오류",
        "region": "ap-northeast-2",
        "view": "table",
        "query": "SOURCE '/jipkok/server' | fields @timestamp, log.logger as logger, message, requestId, memberId, appVersion, platform\n| filter log.level = \"ERROR\"\n| sort @timestamp desc\n| limit 50"
      }
    },
    {
      "type": "text",
      "x": 0,
      "y": 65,
      "width": 24,
      "height": 1,
      "properties": {
        "markdown": "## 프록시"
      }
    },
    {
      "type": "log",
      "x": 0,
      "y": 66,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Caddy 상태 코드",
        "region": "ap-northeast-2",
        "view": "timeSeries",
        "query": "SOURCE '/jipkok/caddy' | fields @timestamp, status\n| filter ispresent(status)\n| stats count() by status, bin(5m)"
      }
    },
    {
      "type": "log",
      "x": 12,
      "y": 66,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Caddy 오류 응답",
        "region": "ap-northeast-2",
        "view": "table",
        "query": "SOURCE '/jipkok/caddy' | fields @timestamp, status, request.uri as uri, request.method as method\n| filter status >= 400\n| sort @timestamp desc\n| limit 50"
      }
    }
  ]
